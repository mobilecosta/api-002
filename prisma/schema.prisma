generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Tenant { tenantId String @id @map("tenant_id") @db.VarChar(32); descricao String @db.VarChar(100); mailOwner String @map("mail_owner") @db.VarChar(250); tokenConfirmation String? @map("token_confirmation") @db.VarChar(32); usuarios Usuario[]; contas Conta[]; categorias Categoria[]; transacoes Transacao[]; @@map("tenant") }
model Usuario { id String @id @default(uuid()); tenantId String @map("tenant_id") @db.VarChar(32); nome String @db.VarChar(120); email String @unique @db.VarChar(250); senha String @db.VarChar(255); tenant Tenant @relation(fields:[tenantId],references:[tenantId]); @@index([tenantId]); @@map("usuario") }
model Conta { id String @id @default(uuid()); tenantId String @map("tenant_id") @db.VarChar(32); nome String @db.VarChar(100); saldo Decimal @default(0) @db.Decimal(15,2); ativo Boolean @default(true); tenant Tenant @relation(fields:[tenantId],references:[tenantId]); transacoes Transacao[]; @@index([tenantId]); @@map("conta") }
model Categoria { id String @id @default(uuid()); tenantId String @map("tenant_id") @db.VarChar(32); nome String @db.VarChar(100); tipo String @db.VarChar(1); tenant Tenant @relation(fields:[tenantId],references:[tenantId]); transacoes Transacao[]; @@index([tenantId]); @@map("categoria") }
model Transacao { id String @id @default(uuid()); tenantId String @map("tenant_id") @db.VarChar(32); contaId String @map("conta_id"); categoriaId String? @map("categoria_id"); tipo String @db.VarChar(1); descricao String @db.VarChar(200); valor Decimal @db.Decimal(15,2); data DateTime; status String @db.VarChar(1); tenant Tenant @relation(fields:[tenantId],references:[tenantId]); conta Conta @relation(fields:[contaId],references:[id]); categoria Categoria? @relation(fields:[categoriaId],references:[id]); @@index([tenantId]); @@index([contaId]); @@index([categoriaId]); @@map("transacao") }